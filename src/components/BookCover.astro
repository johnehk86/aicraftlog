---
import { publicAsset } from '../lib/videos';

interface Props {
  book: { type: string; label: string; title: string; cover: string; coverRatio?: string };
  eager?: boolean;
  class?: string;
}
const { book, eager = false, class: cls } = Astro.props;

// public/books/ 에 표지 파일이 있으면 그 이미지를, 없으면 CSS로 그린 임시 표지를 쓴다
const file = publicAsset(`books/${book.cover}`);
const accent = book.type === 'bundle' ? '#f59e0b' : book.type === 'kindle' ? '#8fb4ff' : '#34d399';
---

{
  file ? (
    <img
      src={file}
      alt={`${book.label} ${book.title} 표지`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={`aspect-ratio:${book.coverRatio ?? '3/4'}`}
      class:list={['block w-full rounded-lg border border-line bg-navy object-cover', cls]}
    />
  ) : (
    <div
      role="img"
      aria-label={`${book.label} ${book.title} 표지`}
      class:list={[
        'relative flex aspect-[3/4] w-full flex-col justify-between overflow-hidden rounded-md bg-navy p-[9%] pl-[14%] shadow-md',
        cls,
      ]}
      style={`--accent:${accent}; container-type:inline-size`}
    >
      <span class="absolute inset-y-0 left-0 w-[4%] bg-[var(--accent)]" />
      <span class="font-mono text-[5.5cqw] tracking-[0.14em] text-[#9aa6c0]">AI × EMBEDDED</span>
      <span>
        <span class="block font-display text-[17cqw] font-medium leading-none text-[var(--accent)]">{book.label}</span>
        <span class="mt-[5cqw] block text-[8.5cqw] font-semibold leading-tight text-white">{book.title}</span>
      </span>
      <span class="font-mono text-[5.5cqw] tracking-[0.14em] text-[#c3cbe0]">TOBY</span>
    </div>
  )
}
