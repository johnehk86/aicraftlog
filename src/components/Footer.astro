---
import site from '../data/site.json';
import books from '../data/books.json';
import Logo from './Logo.astro';

const bundle = books.books.find((b) => b.type === 'bundle');
const kindle = books.books.find((b) => b.type === 'kindle');
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const groups = [
  {
    title: 'SITE',
    links: [...site.nav, { label: '링크 모음', href: '/links' }].map((l) => ({ ...l, attrs: {} })),
  },
  {
    title: 'CHANNELS',
    links: [
      { label: '유튜브', href: site.links.youtube, attrs: { ...ext, 'data-track': 'youtube-footer' } },
      { label: '인스타그램', href: site.links.instagram, attrs: { ...ext, 'data-track': 'instagram-footer' } },
    ],
  },
  {
    title: 'BOOKS',
    links: [
      bundle && { label: `${bundle.label} (${bundle.store})`, href: bundle.url, attrs: { ...ext, 'data-track': 'book-bundle-footer' } },
      kindle && { label: kindle.store, href: kindle.url, attrs: { ...ext, 'data-track': 'book-kindle-footer' } },
    ].filter(Boolean) as { label: string; href: string; attrs: Record<string, string> }[],
  },
];
---

<footer class="mt-24 border-t border-line bg-paper">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_2fr]">
    <div>
      <Logo />
      <p class="mt-4 font-mono text-sm text-mute">{site.slogan}</p>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      {
        groups.map((g) => (
          <div>
            <h2 class="label">{g.title}</h2>
            <ul class="mt-3 space-y-1">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} {...l.attrs} class="inline-block py-1 text-sm text-mute transition-colors hover:text-fg">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="border-t border-line">
    <p class="wrap py-5 font-mono text-xs text-dim">© {new Date().getFullYear()} {site.footer.copyright}</p>
  </div>
</footer>
