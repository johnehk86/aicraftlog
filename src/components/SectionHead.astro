---
interface Props {
  label: string;
  title: string;
  lead?: string;
  as?: 'h1' | 'h2';
  index?: string;
}
const { label, title, lead, as: Tag = 'h2' } = Astro.props;
---

<div class="reveal">
  {
    Tag === 'h1' ? (
      <>
        <span class="tag">{label}</span>
        <h1 class="mt-4 font-serif text-[2.1rem] font-medium leading-tight text-fg md:text-5xl">{title}</h1>
      </>
    ) : (
      <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3">
        <h2 class="text-xl font-semibold text-fg md:text-2xl">{title}</h2>
        <span class="label shrink-0" aria-hidden="true">
          {label}
        </span>
      </div>
    )
  }
  {lead && <p class:list={['max-w-2xl text-mute', Tag === 'h1' ? 'mt-4 md:text-lg' : 'mt-3']}>{lead}</p>}
</div>
