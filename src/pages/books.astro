---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import BookCover from '../components/BookCover.astro';
import Todo from '../components/Todo.astro';
import site from '../data/site.json';
import booksData from '../data/books.json';
import { publicAsset } from '../lib/videos';

const t = site.booksPage;
const { series, books } = booksData;
const bundle = books.find((b) => b.type === 'bundle')!;
const kindle = books.find((b) => b.type === 'kindle')!;
const volumes = books.filter((b) => b.type === 'volume');
const ext = { target: '_blank', rel: 'noopener noreferrer' };

const jsonLd = books.map((b) => {
  const cover = publicAsset(`books/${b.cover}`);
  return {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: b.type === 'kindle' ? b.title : `${series.title} ${b.label} — ${b.title}`,
    author: { '@type': 'Person', name: site.author.name, url: `${site.url}/about` },
    inLanguage: b.type === 'kindle' ? 'en' : 'ko',
    url: b.url,
    isPartOf: { '@type': 'BookSeries', name: series.title },
    ...(b.description ? { description: b.description } : {}),
    ...(cover ? { image: `${site.url}${cover}` } : {}),
  };
});
---

<Base
  title={`${t.title} — ${series.title}`}
  description={`${series.title} 시리즈. ${volumes.map((b) => `${b.label} ${b.title}`).join(', ')}, 통합편, 아마존 킨들판.`}
  jsonLd={jsonLd}
>
  <section class="wrap pt-12 md:pt-16">
    <SectionHead as="h1" label="BOOKS" title={series.title} lead={series.description} />
    <!-- 한눈에 보는 순서 -->
    <ol class="reveal mt-8 flex flex-wrap items-center gap-x-2 gap-y-2 text-xs text-mute" aria-label="학습 순서">
      {
        volumes.map((b, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-dim">→</span>}
            <a href={`#${b.id}`} class="tag !text-fg hover:!border-mute">
              {b.label} {b.title}
            </a>
          </li>
        ))
      }
      <li class="flex items-center gap-2">
        <span aria-hidden="true" class="text-dim">=</span>
        <a href="#bundle" class="tag hover:!border-mute" style="--p:var(--color-gold)">{bundle.label}</a>
      </li>
    </ol>
  </section>

  <!-- 통합편 -->
  <section class="wrap pt-10 md:pt-14" id="bundle">
    <article class="card reveal grid gap-6 p-4 sm:p-6 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-10 lg:p-8">
      <BookCover book={bundle} eager />
      <div>
        <span class="tag" style="--p:var(--color-gold)">{t.bundleTitle}</span>
        <h2 class="mt-3 font-display text-3xl font-medium leading-tight text-fg md:text-4xl">{bundle.title}</h2>
        <p class="mt-3 text-lg font-semibold leading-snug text-fg">{bundle.tagline}</p>
        <p class="mt-2 text-mute">
          {bundle.description}
          <Todo when={bundle.todo} />
        </p>
        {
          bundle.points.length > 0 && (
            <ul class="mt-5 space-y-2 border-t border-line pt-5 text-[15px] text-fg">
              {bundle.points.map((p) => (
                <li class="flex gap-2.5">
                  <svg viewBox="0 0 16 16" class="mt-1 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 8.5l3.2 3L13 4.5" />
                  </svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          )
        }
        <div class="mt-6 grid gap-2.5 sm:grid-cols-2">
          <a href={bundle.url} {...ext} data-track="book-bundle" class="btn btn-primary">
            {bundle.store}에서 보기 <span aria-hidden="true">↗</span>
          </a>
          <a href="#kindle" class="btn">영문판 (Kindle) <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </article>
  </section>

  <!-- 학습 로드맵: 한 권씩 -->
  <section class="wrap pt-16 md:pt-24">
    <SectionHead label="ROADMAP" title={t.roadmapTitle} lead={t.roadmapLead} />
    <ol class="mt-8 grid gap-5 md:grid-cols-2">
      {
        volumes.map((b, i) => (
          <li class="reveal" id={b.id}>
            <article class="card flex h-full flex-col p-4 sm:p-5">
              <BookCover book={b} />
              <div class="mt-5 flex items-center gap-2.5">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-navy text-[11px] font-bold text-white" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="label">
                  Step {i + 1} · {b.step}
                </span>
              </div>
              <h3 class="mt-2 text-2xl font-semibold text-fg">
                <span class="font-display font-medium text-mute">{b.label}</span> {b.title}
                <Todo when={b.todo} />
              </h3>
              {b.tagline && <p class="mt-1.5 font-semibold leading-snug text-fg">{b.tagline}</p>}
              {b.description && <p class="mt-2 text-[15px] text-mute">{b.description}</p>}

              {
                b.topics.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="주제">
                    {b.topics.map((x) => (
                      <li class="tag" style="--p:var(--color-accent)">
                        {x}
                      </li>
                    ))}
                  </ul>
                )
              }

              {
                b.points.length > 0 && (
                  <div class="mt-5">
                    <p class="label">{b.pointsLabel}</p>
                    <ul class="mt-2 divide-y divide-line border-y border-line text-sm">
                      {b.points.map((p) => {
                        const [name, ...rest] = p.split(' — ');
                        return (
                          <li class="flex flex-wrap items-baseline gap-x-3 py-2">
                            <span class="text-[13px] font-semibold text-fg">{name}</span>
                            {rest.length > 0 && <span class="text-mute">{rest.join(' — ')}</span>}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )
              }

              {
                b.flow.length > 0 && (
                  <div class="mt-5">
                    <p class="label">진행 순서</p>
                    <ol class="mt-2 flex flex-wrap items-center gap-x-1.5 gap-y-1.5 text-sm font-medium text-fg">
                      {b.flow.map((f, j) => (
                        <li class="flex items-center gap-1.5">
                          {j > 0 && <span aria-hidden="true" class="text-dim">→</span>}
                          <span class="rounded-md border border-line bg-page px-2 py-1">{f}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                )
              }

              {
                b.recommendedFor.length > 0 && (
                  <div class="mt-5">
                    <p class="label">{t.recommendLabel}</p>
                    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-mute">
                      {b.recommendedFor.map((r) => <li>{r}</li>)}
                    </ul>
                  </div>
                )
              }

              <div class="mt-auto pt-6">
                <a href={b.url} {...ext} data-track={`book-${b.id}`} class="btn btn-dark w-full">
                  {b.store}에서 보기 <span aria-hidden="true">↗</span>
                  <span class="sr-only">
                    — {b.label} {b.title} (새 탭)
                  </span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 킨들판 -->
  <section class="wrap pt-16 md:pt-24" id="kindle">
    <article class="reveal flex flex-col gap-6 rounded-[0.875rem] border border-[#d5e3fc] bg-tint p-5 sm:flex-row sm:items-center sm:gap-8 sm:p-8">
      <div class="mx-auto w-40 shrink-0 sm:mx-0 sm:w-48"><BookCover book={kindle} class="shadow-md" /></div>
      <div lang="en">
        <span class="tag" style="--p:var(--color-blue)" lang="ko">{t.kindleTitle}</span>
        <h2 class="mt-3 font-display text-3xl font-medium leading-tight text-fg md:text-4xl">{kindle.title}</h2>
        <p class="mt-2 font-semibold text-fg">{kindle.tagline}</p>
        <p class="mt-2 text-mute" lang="ko">
          {kindle.description}
          <Todo when={kindle.todo} />
        </p>
        <a href={kindle.url} {...ext} data-track="book-kindle" class="btn btn-dark mt-5 w-full sm:w-auto">
          {kindle.store} <span aria-hidden="true">↗</span>
          <span class="sr-only" lang="ko">(새 탭)</span>
        </a>
      </div>
    </article>
  </section>
</Base>
