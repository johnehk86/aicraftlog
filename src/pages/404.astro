---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다">
  <section class="wrap py-24 text-center md:py-32">
    <p class="text-sm text-accent">ERR 404 · NO SIGNAL</p>
    <h1 class="mt-4 font-display text-3xl font-medium md:text-4xl">페이지를 찾을 수 없습니다</h1>
    <p class="mt-3 text-mute">주소가 바뀌었거나 없는 페이지입니다.</p>
    <a href="/" class="btn btn-dark mt-8">홈으로 가기</a>
  </section>
</Base>
