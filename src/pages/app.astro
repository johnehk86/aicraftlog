---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import site from '../data/site.json';

const t = site.appPage;
---

<Base title={t.title} description={t.lead}>
  <section class="wrap max-w-3xl pt-12 md:pt-16">
    <SectionHead as="h1" label="APP" title={t.title} lead={t.lead} />

    <!-- 앱 소개 + 바로 설치 -->
    <div class="card reveal mt-8 flex flex-col gap-5 p-5 sm:flex-row sm:items-center sm:p-6">
      <img src="/icons/icon-192.png" alt="" width="88" height="88" class="h-[88px] w-[88px] shrink-0 rounded-[22px] border border-line shadow-sm" />
      <div class="min-w-0 flex-1">
        <p class="text-lg font-semibold text-fg">{site.name}</p>
        <p class="mt-0.5 text-sm text-mute">{t.appSub}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {t.features.map((f) => <li class="tag" style="--p:var(--color-accent)">{f}</li>)}
        </ul>
      </div>
    </div>

    <!-- 상태별 안내 (스크립트가 하나만 보여 준다. 스크립트가 없으면 아래 방법 목록만 보인다) -->
    <div class="mt-4" aria-live="polite">
      <div data-state="installable" hidden class="rounded-[0.875rem] border border-[#d5e3fc] bg-tint p-5">
        <p class="font-semibold text-fg">{t.installableTitle}</p>
        <button type="button" data-install data-track="app-install" class="btn btn-primary mt-3 w-full sm:w-auto">{t.installButton}</button>
      </div>
      <div data-state="installed" hidden class="rounded-[0.875rem] border border-[#a7f3d0] bg-[#ecfdf5] p-5">
        <p class="font-semibold text-fg">{t.installedTitle}</p>
        <p class="mt-1 text-sm text-mute">{t.installedLead}</p>
      </div>
      <div data-state="inapp" hidden class="rounded-[0.875rem] border border-[#fde68a] bg-[#fffbeb] p-5">
        <p class="font-semibold text-fg">{t.inAppTitle}</p>
        <p class="mt-1 text-sm leading-relaxed text-mute">{t.inAppLead}</p>
        <button type="button" data-copy-link class="btn mt-3 w-full sm:w-auto">{t.copyLink}</button>
      </div>
    </div>

    <!-- 기기별 방법 -->
    <h2 class="mt-12 font-display text-2xl text-fg">{t.howTitle}</h2>
    <ol class="mt-4 space-y-3">
      {
        t.methods.map((m) => (
          <li class="reveal" data-method={m.id}>
            <article class="card p-5">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-[17px] font-semibold text-fg">{m.name}</h3>
                <span data-mine-badge hidden class="tag" style="--p:var(--color-blue)">{t.mineBadge}</span>
              </div>
              <ol class="mt-3 space-y-1.5 text-[15px] text-mute">
                {m.steps.map((s, i) => (
                  <li class="flex gap-2.5">
                    <span class="grid h-5 w-5 shrink-0 translate-y-0.5 place-items-center rounded-full bg-tint text-[11px] font-bold text-fg" aria-hidden="true">
                      {i + 1}
                    </span>
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
            </article>
          </li>
        ))
      }
    </ol>

    <p class="mt-8 text-sm leading-relaxed text-dim">{t.note}</p>
  </section>
</Base>

<script>
  const ua = navigator.userAgent;
  const html = document.documentElement;
  const show = (state: string) =>
    document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== state));

  const ios = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const android = /Android/.test(ua);
  // 인스타그램·스레드·페이스북·카카오톡·네이버 앱 안의 브라우저에서는 설치할 수 없다
  const inApp = /Instagram|Barcelona|FBAN|FBAV|KAKAOTALK|NAVER\(inapp|Line\//i.test(ua);
  const samsung = /SamsungBrowser/.test(ua);

  const mine = ios ? 'ios' : samsung ? 'samsung' : android ? 'android' : 'desktop';
  const card = document.querySelector<HTMLElement>(`[data-method="${mine}"]`);
  if (card) {
    card.querySelector('article')!.classList.add('!border-navy', 'ring-1', 'ring-navy');
    card.querySelector<HTMLElement>('[data-mine-badge]')!.hidden = false;
    card.parentElement!.prepend(card); // 내 기기 방법을 맨 위로
  }

  const update = () => {
    if (html.classList.contains('app') || html.classList.contains('installed')) show('installed');
    else if (inApp) show('inapp');
    else if (html.classList.contains('can-install')) show('installable');
    else show('');
  };
  update();
  new MutationObserver(update).observe(html, { attributes: true, attributeFilter: ['class'] });

  document.querySelector('[data-copy-link]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      btn.textContent = '주소를 복사했습니다';
    } catch {
      btn.textContent = location.href;
    }
  });
</script>
