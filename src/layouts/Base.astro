---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object | object[];
  /** /links 처럼 헤더·푸터 없이 쓰는 페이지 */
  bare?: boolean;
}
const { title, description = site.description, jsonLd, bare = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const gaId = import.meta.env.PUBLIC_GA_ID;
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AI Craft Log" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#f8f9ff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
      // 앱으로 설치해서 열었으면 표시 (설치 버튼 숨김용)
      if (matchMedia('(display-mode: standalone)').matches || navigator.standalone) document.documentElement.classList.add('app');
    </script>

    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </head>
  <body class="min-h-dvh bg-page text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-amber focus:px-3 focus:py-2 focus:text-on-cta"
      >본문으로 건너뛰기</a
    >
    {!bare && <Header />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}

    <script>
      // 스크롤 등장
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }

      // 앱 설치: 서비스 워커 등록 + 설치 버튼
      // data-install 버튼은 평소엔 /app 안내 페이지로 가는 링크이고, 브라우저가 바로 설치를 지원하면(안드로이드·PC 크롬/엣지) 설치 창을 띄운다.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
      let installPrompt: any = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        installPrompt = e;
        document.documentElement.classList.add('can-install');
      });
      window.addEventListener('appinstalled', () => {
        installPrompt = null;
        document.documentElement.classList.remove('can-install');
        document.documentElement.classList.add('installed');
        (window as any).gtag?.('event', 'app_installed');
      });
      document.addEventListener('click', async (ev) => {
        const el = (ev.target as Element | null)?.closest('[data-install]');
        if (!el || !installPrompt) return;
        ev.preventDefault();
        installPrompt.prompt();
        const { outcome } = await installPrompt.userChoice;
        if (outcome === 'accepted') installPrompt = null;
      });

      // 버튼 클릭 추적: data-track="youtube" 같은 속성이 붙은 링크 클릭을 GA4 이벤트로 보낸다 (GA가 켜져 있을 때만)
      document.addEventListener('click', (ev) => {
        const el = (ev.target as Element | null)?.closest<HTMLElement>('[data-track]');
        const gtag = (window as any).gtag;
        if (!el || typeof gtag !== 'function') return;
        gtag('event', 'cta_click', {
          cta: el.dataset.track,
          link_url: el.getAttribute('href') ?? '',
          page_path: location.pathname,
        });
      });
    </script>
  </body>
</html>
