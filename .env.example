# 분석 도구 (선택). 값을 넣으면 자동으로 켜지고, 비워 두면 아무것도 로드하지 않습니다.
# 이 파일을 .env 로 복사해서 쓰거나, 호스팅(Cloudflare Pages / Vercel)의 환경 변수에 넣으세요.

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Cloudflare Web Analytics 토큰
PUBLIC_CF_BEACON_TOKEN=

# 게시판 (Supabase). 두 값을 모두 넣어야 게시판이 켜집니다. 설정 방법: docs/BOARD.md
# 둘 다 브라우저에 공개되어도 되는 값입니다. (service_role / secret 키는 절대 넣지 마세요)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
